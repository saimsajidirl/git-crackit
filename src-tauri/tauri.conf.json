{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Crackit",
  "version": "0.1.0",
  "identifier": "com.gitcrackit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Git Crackit",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0a0b10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://avatars.githubusercontent.com; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwNjJDQkE1RjYwQUQ3N0IKUldSNzF3cjJwY3RpNEFqYkFOQ2hWUWVEc0V0dll3Z3BMdkYrdi8wWmVxeGRrdzFmeWYyMHpiZHUK",
      "endpoints": [
        "https://github.com/saimsajidirl/git-crackit/releases/latest/download/latest.json"
      ]
    }
  }
}
